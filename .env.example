# Copy to `.env` and fill in. Everything optional except the DB.
DATABASE_URL=sqlite:///./test.db

# --- Reliability / demo mode (Part 9/10) ---
# DEMO_MODE gates the one-click demo scenarios behind a flag so a live
# deployment is never accidentally exercised by demo data. Defaults to TRUE.
# Set to false|0|off|no to disable the demo endpoints entirely.
DEMO_MODE=true

# --- Solana payment layer ---
# Leave SOLANA_RPC_URL blank for MOCK MODE (simulated blockchain transactions).
# To enable REAL MODE, set SOLANA_RPC_URL, SOLANA_PRIVATE_KEY, and USE_REAL_PAYMENT=true.
SOLANA_RPC_URL=
SOLANA_NETWORK=devnet
SOLANA_USDC_MINT=
SOLANA_PRIVATE_KEY=
USE_REAL_PAYMENT=false
# Optional: RPC URL used by the browser to read wallet balances / build transfers.
NEXT_PUBLIC_SOLANA_RPC_URL=
# Optional: override USDC mint the browser queries for balances.
NEXT_PUBLIC_SOLANA_USDC_MINT=

# --- AI providers (leave blank for a deterministic mock responder) ---
# Server-level keys are shared by every user. End users can instead attach
# their OWN key per wallet from the Settings page (stored encrypted, per-user,
# and preferred over these server keys when both exist).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Fernet key (urlsafe base64 of 32 bytes) for encrypting end-user API keys at
# rest. Blank = auto-derived from SECRET_KEY (fine for dev, set one in prod).
LLM_KEY_ENCRYPTION_KEY=
# Optional: PostgreSQL (instead of SQLite) for production. Example value:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/bank
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Distributed state. If REDIS_URL is unreachable the service transparently
# falls back to an in-memory store with the same API semantics.
REDIS_URL=redis://localhost:6379
HELIUS_API_KEY=
X402_API_KEY=